# Copy to .env.local for local development. Set the same values in Vercel → Project → Settings → Environment Variables.

# --- Classifieds admin (/admin) ---
# Password Scott uses to sign in. Pick something long.
ADMIN_PASSWORD=
# Random string used to sign the login cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Classifieds storage ---
# Added automatically when you connect a Vercel Blob store to the project
# (Vercel → Storage → Create → Blob). Leave empty locally to store data in .data/.
BLOB_READ_WRITE_TOKEN=

# --- Contact form email (Resend) ---
RESEND_API_KEY=
# Where form submissions go. Comma-separate multiple addresses.
CONTACT_TO_EMAIL=info@karnipier.com
# Must be on a domain verified in Resend, e.g. website@pierstoyou.com
CONTACT_FROM_EMAIL="Piers 2U Website <website@pierstoyou.com>"
